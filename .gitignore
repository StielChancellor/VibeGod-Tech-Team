# Ingest scratch — cloned third-party repos, never committed
ingest/_scratch/

# Node / tooling
node_modules/
*.log
.DS_Store

# Local journey-canvas runtime state (generated)
**/.journey-canvas-state.json

# Visual-check screenshots + report (generated by the Playwright tool)
**/.vibegod-visual-check/

# Resolved graphify invocation (machine-specific — written by /graph)
.graphify-path

# Secrets — a dotenv file is where real credentials belong, so it must never be tracked.
# guard-commit blocks a credential reaching a commit; this is the prevention that should mean
# it never has to fire. This repo is the pattern users copy, so it states the rule explicitly.
.env
.env.*
!.env.example
